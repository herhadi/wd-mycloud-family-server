#!/bin/sh
### BEGIN INIT INFO
# Provides:          syncthing
# Required-Start:    $remote_fs $network
# Required-Stop:     $remote_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Syncthing service for WD My Cloud Gen1
### END INIT INFO

# Template for the Debian Jessie WD My Cloud installation.
# Verify the binary path before installing on another device.

DAEMON=/usr/local/bin/syncthing
USER=syncthing
HOME=/var/lib/syncthing
GUI_ADDRESS=0.0.0.0:8384
PIDFILE=/var/run/syncthing.pid

case "$1" in
  start)
    echo "Starting Syncthing..."
    start-stop-daemon --start --background --make-pidfile --pidfile "$PIDFILE" \
      --chuid "$USER" --chdir "$HOME" --exec "$DAEMON" -- \
      --home="$HOME" --gui-address="$GUI_ADDRESS"
    ;;
  stop)
    echo "Stopping Syncthing..."
    start-stop-daemon --stop --pidfile "$PIDFILE" --retry=TERM/30/KILL/5
    rm -f "$PIDFILE"
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
  status)
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      echo "Syncthing is running (PID $(cat "$PIDFILE"))"
      exit 0
    fi
    echo "Syncthing is not running"
    exit 3
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}"
    exit 1
    ;;
esac
exit 0
